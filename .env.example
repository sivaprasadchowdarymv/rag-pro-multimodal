# Copy to .env for local runs (Windows: copy .env.example .env).
# On Streamlit Community Cloud put these in the app's Secrets instead.
# Placeholders only: NEVER commit real keys.

# ---- Persistent storage (recommended on Streamlit Cloud) -------------------
# Private Hugging Face dataset that keeps chats, feedback, preferences and
# document indexes across restarts. The dataset is created (private) automatically.
HF_TOKEN=
HF_DATASET_REPO=            # e.g. your-hf-username/rag-pro-multimodal-data  (or file:///path for a local disk)
SYNC_INTERVAL=45            # seconds between background uploads

# ---- Access (optional) -------------------------------------------------------
APP_PASSWORD=               # if set, the whole app asks for this password

# ---- Providers (free-first: only providers with a key are ever called) -----
GROQ_API_KEY=
OLLAMA_API_KEY=
# Fallback order. Unconfigured providers are skipped automatically.
LLM_PROVIDERS=groq,ollama_cloud,ollama_local
# Local Ollama is opt-in (it must be reachable from where the app runs)
ENABLE_OLLAMA_LOCAL=false
OLLAMA_LOCAL_HOST=http://localhost:11434

# ---- Models by role (empty = sensible default per provider) -----------------
# Applies to the FIRST configured provider. Per-provider overrides also work,
# e.g. GROQ_MASTER_MODEL=openai/gpt-oss-120b, OLLAMA_CLOUD_FAST_MODEL=gpt-oss:20b
MASTER_MODEL=
FAST_MODEL=
VERIFIER_MODEL=
# Vision model: reads page images and figures. Local Ollama default: gemma3:4b (free, no key).
# For a cloud provider set a vision model it offers, e.g. GROQ_VISION_MODEL=... (per-provider override)
VISION_MODEL=

# ---- Pipeline -------------------------------------------------------------------
PIPELINE_MODE=pro            # pro | legacy  (LEGACY_MODE=true also works)
AGENT_MODE=agent             # agent (ReAct when needed) | quick (one call)
AGENT_MAX_STEPS=3
RERANK=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
VERIFY_WITH_LLM=false        # deterministic checks always run; this adds an LLM check
MAX_REGENERATIONS=1
MEMORY_TURNS=3
# faithfulness, relevance, citation accuracy, grounding, user feedback
HEALTH_WEIGHTS=0.30,0.20,0.20,0.20,0.10
SUPPORT_THRESHOLD=0.0       # cross-encoder score below which a citation counts as weakly supported

# ---- Retrieval, chunking, uploads -------------------------------------------
TOP_K=3
CHUNK_SIZE=400
CHUNK_OVERLAP=60
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_CHARS=5000
MAX_UPLOAD_MB=25
MAX_PAGES=300
LLM_TEMPERATURE=0.1
LOG_LEVEL=INFO

# ---- Production guards --------------------------------------------------------
RATE_LIMIT_PER_MIN=8           # questions per browser session per minute (0 = off)
GLOBAL_RATE_LIMIT_PER_MIN=25   # questions per minute for the whole server (Groq free ~30 RPM)
ANSWER_CACHE_SIZE=256          # identical standalone questions are answered from cache
ANSWER_CACHE_TTL=3600          # seconds (0 = cache off)
COST_PER_1K_TOKENS=0           # free plans cost 0; set only to estimate paid usage

# ---- Cross-modal concept linking -------------------------------------------
CONCEPT_LINKING=true          # link text/table/figure/equation mentions of the same concept
CONCEPT_EXPAND_MAX=4          # max linked items added per question (reranker still filters)
CONCEPT_MIN_CONF=0.6          # minimum link confidence used for expansion
CONCEPT_LLM_RESOLVE=false     # use the fast LLM only for ambiguous abbreviations (cached)

# ---- Multimodal: ColPali page search + vision reading of page images --------
# Needs: pip install -r requirements-visual.txt (torch + colpali-engine). Docker/HF Space include it.
VISUAL_RETRIEVAL=auto        # auto (on when installed) | on | off
COLPALI_MODEL=auto           # auto = vidore/colpali-v1.3 on GPU, vidore/colSmol-256M on CPU
COLPALI_BATCH=2              # pages per ColPali pass (lower = less RAM)
VISUAL_TOP_K=4               # pages ColPali adds to the evidence fusion per question
VISUAL_MAX_PAGES=300         # pages per document embedded by ColPali
PAGE_DPI=110                 # page image resolution
PAGE_MAX_SIDE=1400           # longest side of a stored page image (px)
MULTIMODAL_ANSWER=auto       # auto (figure questions, figure/scanned pages, no text match) | on | off
VISION_READ_PAGES=2          # page images the vision model reads per question
# Free local vision with Ollama (ollama pull gemma3:4b), alongside Groq for answers:
#   LLM_PROVIDERS=groq,ollama_local
#   ENABLE_OLLAMA_LOCAL=true
